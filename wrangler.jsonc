{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nitm",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nitm",
      "database_id": "acd4fc53-6a8b-44e3-9b23-26fcb3a62bf2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "BOOTSTRAP_ADMIN_EMAIL": "minkyu.shim@gmail.com",
    "MAIL_FROM": "NitM <onboarding@resend.dev>"
  },
    "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
